PORT=5050
NODE_ENV=development

# MySQL connection (match docker-compose defaults, or your own DB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=roblox_gigs
DB_USER=app
DB_PASSWORD=apppassword

# Admin auth (single account)
ADMIN_USERNAME=admin
# bcrypt hash of your chosen password.
# Generate with: node -e "console.log(require('bcrypt').hashSync('yourPassword', 10))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
ADMIN_JWT_SECRET=change-this-secret

# CORS
FRONTEND_ORIGIN=http://localhost:5175

