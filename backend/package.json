{
  "name": "roblox-gigs-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Roblox build gigs website",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "migrate:make": "knex --knexfile knexfile.cjs migrate:make",
    "seed": "knex --knexfile knexfile.cjs seed:run"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "pg": "^8.19.0",
    "slugify": "^1.6.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
